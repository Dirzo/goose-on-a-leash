{
  "name": "goose-on-a-leash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 16-bit action-adventure where your only weapon is a furious goose on a leash. A noobscrub game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx wrangler deploy",
    "build:single": "npm run build && node scripts/single-file.mjs",
    "build:cdn": "vite build --mode cdn && node scripts/single-file.mjs --cdn",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
